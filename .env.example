# X (Twitter) API v2 — 二选一即可
# 推荐：Bearer Token（App-only，读推文）
X_BEARER_TOKEN=

# 可选：用户级 OAuth 1.0a（若 Bearer 不可用）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Reddit OAuth（https://www.reddit.com/prefs/apps 创建 script 应用）
# 匿名 JSON 自 2026 起大多 403，强烈建议配置
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 扫描窗口（天）
SCAN_LOOKBACK_DAYS=2

# 报告输出目录
REPORT_DIR=data/reports